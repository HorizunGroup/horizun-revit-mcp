<?xml version="1.0" encoding="utf-8"?>
<!--
  Horizun Revit MCP - original Horizun code (Apache-2.0).

  THE PART OF THE W3C XML SCHEMA VOCABULARY THAT ids-1.0.xsd REFERS TO, AND NOTHING ELSE.

  buildingSMART's ids.xsd 1.0 imports http://www.w3.org/2001/XMLSchema.xsd and uses two
  things from it: the element xs:restriction (an idsValue may be one) and the attribute
  group xs:occurs (minOccurs/maxOccurs on <applicability>). A validator that cannot reach
  the network has to be given those two definitions some other way, and fetching the W3C
  schema-for-schemas at run time would make "is this IDS valid?" depend on the Wi-Fi.

  So the server hands the XSD compiler THIS file for that import. It declares:
    - xs:restriction: an optional base (QName) and any number of the twelve constraining
      facets of XML Schema 1.0 Part 2, section 4.3, each with a required 'value';
    - xs:occurs: minOccurs (nonNegativeInteger, default 1) and maxOccurs
      (nonNegativeInteger or 'unbounded', default 1).
  It is deliberately a SUBSET: it does not model xs:annotation or a nested xs:simpleType
  inside a restriction, which an IDS file has no reason to carry; a file that does is
  reported invalid rather than accepted on a guess. ids-1.0.xsd itself is used verbatim.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:complexType name="facet">
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="fixed" type="xs:boolean" use="optional"/>
    <xs:attribute name="id" type="xs:ID" use="optional"/>
  </xs:complexType>
  <xs:element name="minExclusive" type="xs:facet"/>
  <xs:element name="minInclusive" type="xs:facet"/>
  <xs:element name="maxExclusive" type="xs:facet"/>
  <xs:element name="maxInclusive" type="xs:facet"/>
  <xs:element name="totalDigits" type="xs:facet"/>
  <xs:element name="fractionDigits" type="xs:facet"/>
  <xs:element name="length" type="xs:facet"/>
  <xs:element name="minLength" type="xs:facet"/>
  <xs:element name="maxLength" type="xs:facet"/>
  <xs:element name="enumeration" type="xs:facet"/>
  <xs:element name="whiteSpace" type="xs:facet"/>
  <xs:element name="pattern" type="xs:facet"/>
  <xs:element name="restriction">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="xs:minExclusive"/>
        <xs:element ref="xs:minInclusive"/>
        <xs:element ref="xs:maxExclusive"/>
        <xs:element ref="xs:maxInclusive"/>
        <xs:element ref="xs:totalDigits"/>
        <xs:element ref="xs:fractionDigits"/>
        <xs:element ref="xs:length"/>
        <xs:element ref="xs:minLength"/>
        <xs:element ref="xs:maxLength"/>
        <xs:element ref="xs:enumeration"/>
        <xs:element ref="xs:whiteSpace"/>
        <xs:element ref="xs:pattern"/>
      </xs:choice>
      <xs:attribute name="base" type="xs:QName" use="optional"/>
      <xs:attribute name="id" type="xs:ID" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:attributeGroup name="occurs">
    <xs:attribute name="minOccurs" type="xs:nonNegativeInteger" use="optional" default="1"/>
    <xs:attribute name="maxOccurs" use="optional" default="1">
      <xs:simpleType>
        <xs:union memberTypes="xs:nonNegativeInteger">
          <xs:simpleType>
            <xs:restriction base="xs:NMTOKEN">
              <xs:enumeration value="unbounded"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:union>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
</xs:schema>
