<Project>
  <PropertyGroup>
    <!-- One product, one release number. The server and every Revit payload
         inherit this value and are packaged/deployed as an inseparable pair. -->
    <Version>1.1.5</Version>
    <!-- Published tags never move. v1.1.5 keeps the inventory census out of
         Revit's view-geometry regeneration path; detailed planimetry modes
         still read and verify their geometry explicitly. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
