<Project>
  <PropertyGroup>
    <!-- One product, one release number. The server and every Revit payload
         inherit this value and are packaged/deployed as an inseparable pair. -->
    <Version>1.1.4</Version>
    <!-- Published tags never move. v1.1.4 binds the live cancellation probe to
         the safer measured contract: queued work is removed before start and
         leaves its confirmation token and idempotency key unconsumed. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
