<Project>
  <PropertyGroup>
    <!-- One product, one release number. The server and every Revit payload
         inherit this value and are packaged/deployed as an inseparable pair. -->
    <Version>1.1.1</Version>
    <!-- Published tags never move. v1.1.1 is the clean-runner recovery for the
         inventory generator defect found by the failed v1.1.0 tag pipeline. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
