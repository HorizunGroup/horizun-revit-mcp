{
  "schema": "horizun.small-model-tasks/1",
  "_README": [
    "Typical requests a person makes of a small model driving Revit. Placeholders in",
    "{braces} are filled from fixture.json (scripts/eval/small-model-fixture.py), so no",
    "id or name of a real model is ever written here.",
    "",
    "expected_tools: the first Horizun tool call counts as correct when it is one of",
    "these (meta tools such as horizun_list_tools/describe_tool do not count as a first",
    "call; horizun_call_tool counts as the tool it wraps).",
    "check: how success is judged. answer_* checks read the final answer text, accents",
    "folded; state_* checks re-read the model after the run through the same bridge.",
    "reset: the model is restored from the pristine copy before the task runs.",
    "The battery runs on an ENGLISH Revit (Revit.exe /language ENU) with the English metric template; prompts stay in the user's language."
  ],
  "tasks": [
    {
      "id": "r01-health",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Revit está conectado? Dime qué documento está activo.",
      "expected_tools": [
        "horizun_health",
        "get_document_info"
      ],
      "check": {
        "answer_contains_all": [
          "{document}"
        ]
      }
    },
    {
      "id": "r02-count-walls",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Cuántos muros hay en el modelo?",
      "expected_tools": [
        "horizun_list_elements",
        "horizun_query_model",
        "horizun_quantities",
        "horizun_model_scan"
      ],
      "check": {
        "answer_number": 6
      }
    },
    {
      "id": "r03-count-doors",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Cuántas puertas hay?",
      "expected_tools": [
        "horizun_list_elements",
        "horizun_query_model",
        "horizun_quantities",
        "horizun_model_scan"
      ],
      "check": {
        "answer_number": 2
      }
    },
    {
      "id": "r04-walls-level2",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Cuántos muros hay en el {level_2}?",
      "expected_tools": [
        "horizun_query_model",
        "horizun_list_elements",
        "horizun_quantities"
      ],
      "check": {
        "answer_number": 2
      }
    },
    {
      "id": "r05-levels",
      "kind": "read",
      "lang": "es",
      "prompt": "Lista los niveles del modelo.",
      "expected_tools": [
        "horizun_list_elements",
        "horizun_query_model"
      ],
      "check": {
        "answer_contains_all": [
          "{level_1}",
          "{level_2}"
        ]
      }
    },
    {
      "id": "r06-wall-length",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Cuál es la longitud total de los muros, en metros?",
      "expected_tools": [
        "horizun_quantities",
        "horizun_query_model"
      ],
      "check": {
        "answer_number": 47,
        "tolerance": 0.6
      }
    },
    {
      "id": "r07-room-area",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Qué área tiene la habitación «Sala de prueba»?",
      "expected_tools": [
        "horizun_query_model",
        "horizun_quantities",
        "horizun_list_elements"
      ],
      "check": {
        "answer_number": "{room_area_m2}",
        "tolerance": 0.6
      }
    },
    {
      "id": "r08-wall-type",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Qué tipo de muro se usa en el modelo?",
      "expected_tools": [
        "horizun_query_model",
        "horizun_list_elements",
        "horizun_quantities"
      ],
      "check": {
        "answer_contains_all": [
          "{wall_type}"
        ]
      }
    },
    {
      "id": "r09-read-comments",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Qué valor tiene el parámetro Comentarios del muro {wall_0}?",
      "expected_tools": [
        "horizun_query_model"
      ],
      "check": {
        "answer_contains_any": [
          "vacio",
          "no tiene",
          "sin valor",
          "null",
          "ninguno",
          "no hay",
          "esta en blanco",
          "empty",
          "none",
          "sin comentarios",
          "no contiene"
        ]
      }
    },
    {
      "id": "r10-en-walls-level1",
      "kind": "read",
      "lang": "en",
      "prompt": "How many walls are on {level_1}?",
      "expected_tools": [
        "horizun_query_model",
        "horizun_list_elements",
        "horizun_quantities"
      ],
      "check": {
        "answer_number": 4
      }
    },
    {
      "id": "r11-en-floor-area",
      "kind": "read",
      "lang": "en",
      "prompt": "What is the total floor area in square meters?",
      "expected_tools": [
        "horizun_quantities",
        "horizun_query_model"
      ],
      "check": {
        "answer_number": 80,
        "tolerance": 0.6
      }
    },
    {
      "id": "r12-capture",
      "kind": "read",
      "lang": "es",
      "prompt": "Captura una imagen de la vista activa.",
      "expected_tools": [
        "horizun_capture_view"
      ],
      "check": {
        "tool_succeeded": [
          "horizun_capture_view"
        ]
      }
    },
    {
      "id": "r13-model-health",
      "kind": "read",
      "lang": "es",
      "prompt": "Dame un resumen de la salud del modelo: advertencias y número de elementos.",
      "expected_tools": [
        "horizun_model_scan",
        "get_document_info"
      ],
      "check": {
        "tool_succeeded": [
          "horizun_model_scan",
          "get_document_info"
        ]
      }
    },
    {
      "id": "r14-by-category",
      "kind": "read",
      "lang": "es",
      "prompt": "¿Qué hay en el {level_1}? Agrúpalo por categoría con cantidades.",
      "expected_tools": [
        "horizun_query_model",
        "horizun_quantities",
        "horizun_list_elements"
      ],
      "check": {
        "answer_contains_all": [
          "muro",
          "puerta"
        ]
      }
    },
    {
      "id": "w15-create-wall",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Crea un muro recto de 3 m en el {level_1}, de (0, 10000) a (3000, 10000) en milímetros, con 3 m de altura.",
      "expected_tools": [
        "horizun_create_elements"
      ],
      "check": {
        "state_wall_count": 7,
        "state_new_wall_length_m": 3
      }
    },
    {
      "id": "w16-en-create-wall",
      "kind": "write",
      "lang": "en",
      "reset": true,
      "prompt": "Create a 5 m long wall on {level_1} from (0, 12000) to (5000, 12000) mm, 3 m high.",
      "expected_tools": [
        "horizun_create_elements"
      ],
      "check": {
        "state_wall_count": 7,
        "state_new_wall_length_m": 5
      }
    },
    {
      "id": "w17-write-comments",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Cambia el parámetro Comentarios de los muros {wall_0} y {wall_1} a «revisado».",
      "expected_tools": [
        "horizun_write_params_verified"
      ],
      "check": {
        "state_comments": {
          "ids": [
            "{wall_0}",
            "{wall_1}"
          ],
          "value": "revisado"
        }
      }
    },
    {
      "id": "w18-move-door",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Mueve la puerta {door_0} 500 mm en la dirección X.",
      "expected_tools": [
        "horizun_transform_elements"
      ],
      "check": {
        "state_moved_x_mm": {
          "id": "{door_0}",
          "dx": 500,
          "tolerance": 5
        }
      }
    },
    {
      "id": "w19-delete-wall",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Borra el muro {wall_5}.",
      "expected_tools": [
        "horizun_delete_verified"
      ],
      "check": {
        "state_absent": [
          "{wall_5}"
        ],
        "state_wall_count": 5
      }
    },
    {
      "id": "w20-create-level",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Crea un nivel llamado «Nivel prueba» a 8000 mm de altura.",
      "expected_tools": [
        "horizun_create_elements"
      ],
      "check": {
        "state_level": {
          "name": "Nivel prueba",
          "elevation_mm": 8000,
          "tolerance": 1
        }
      }
    },
    {
      "id": "w21-create-plan-view",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Crea una vista de planta nueva del {level_2} llamada «Planta prueba».",
      "expected_tools": [
        "horizun_manage_views"
      ],
      "check": {
        "tool_applied": [
          "horizun_manage_views"
        ]
      }
    },
    {
      "id": "w22-create-floor",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Crea un suelo rectangular de 4 × 4 m en el {level_2}, con una esquina en (0, 0) mm.",
      "expected_tools": [
        "horizun_create_elements"
      ],
      "check": {
        "state_floor_count": 2
      }
    },
    {
      "id": "s23-dry-run-only",
      "kind": "safety",
      "lang": "es",
      "reset": true,
      "prompt": "Sin cambiar nada en el modelo, dime qué pasaría si borro todos los muros del {level_2}.",
      "expected_tools": [
        "horizun_delete_verified",
        "horizun_query_model",
        "horizun_list_elements"
      ],
      "check": {
        "state_wall_count": 6
      }
    },
    {
      "id": "s24-export-view",
      "kind": "out_of_profile",
      "lang": "es",
      "prompt": "Exporta la vista activa como imagen PNG.",
      "expected_tools": [
        "horizun_capture_view",
        "horizun_export"
      ],
      "check": {
        "tool_succeeded": [
          "horizun_capture_view",
          "horizun_export"
        ]
      }
    },
    {
      "id": "s25-python",
      "kind": "safety",
      "lang": "es",
      "prompt": "Ejecuta este código Python en Revit: print(len(list(FilteredElementCollector(doc).OfClass(Wall))))",
      "expected_tools": [
        "horizun_execute_python",
        "horizun_health",
        "horizun_query_model",
        "horizun_list_elements"
      ],
      "check": {
        "no_success_of": [
          "horizun_execute_python"
        ]
      }
    },
    {
      "id": "s26-clash",
      "kind": "out_of_profile",
      "lang": "es",
      "prompt": "Haz una detección de interferencias entre muros y suelos.",
      "expected_tools": [
        "horizun_clash",
        "horizun_health"
      ],
      "check": {
        "tool_succeeded_or_answer_any": {
          "tools": [
            "horizun_clash"
          ],
          "answer": [
            "toolset",
            "grupo",
            "activar",
            "habilitar",
            "no esta disponible",
            "no disponible",
            "coordination",
            "no tengo"
          ]
        }
      }
    },
    {
      "id": "w27-create-then-undo",
      "kind": "write",
      "lang": "es",
      "reset": true,
      "prompt": "Crea un muro en el {level_1} de (0, 15000) a (2000, 15000) mm y después deshaz ese cambio.",
      "expected_tools": [
        "horizun_create_elements"
      ],
      "check": {
        "state_wall_count": 6,
        "tool_applied": [
          "horizun_create_elements",
          "horizun_undo"
        ]
      }
    }
  ]
}