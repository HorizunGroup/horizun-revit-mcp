    {
      "id": "room-offices-declared",
      "selector": {
        "category": "OST_Rooms",
        "name_matches": "(?i)oficina|office"
      },
      "assertion": {
        "parameter": "Illuminance (declared)",
        "unit": "lx",
        "operator": "gte",
        "value": 500,
        "missing_is": "not_decidable"
      },
      "severity": "advisory",
      "source": {
        "norm": "RETILAP 2024 (Resolucion 40150 de 2024), Libro 3",
        "numeral": "Tabla 3.2.2.6 a, ref. 26.2",
        "text": "oficinas: Em = 500 lx"
      },
      "note": "Template for a Room carrying a DECLARED illuminance: 'Illuminance (declared)' is a placeholder name - use your project's parameter. A room without the datum is not_decidable, never a pass."
    }
  ]
}
