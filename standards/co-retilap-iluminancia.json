        "value": 100
      },
      "severity": "advisory",
      "source": {
        "norm": "RETILAP 2024 (Resolucion 40150 de 2024), Libro 3",
        "numeral": "Tabla 3.2.2.6 a, ref. 1.1",
        "text": "corredores y areas de circulacion: Em = 100 lx"
      }
    },
    {
      "id": "space-stairs",
      "selector": {
        "category": "OST_MEPSpaces",
        "name_matches": "(?i)escalera|stair"
      },
      "assertion": {
        "measure": "space_illuminance_lx",
        "operator": "gte",
        "value": 100
      },
      "severity": "advisory",
      "source": {
        "norm": "RETILAP 2024 (Resolucion 40150 de 2024), Libro 3",
        "numeral": "Tabla 3.2.2.6 a, ref. 1.2",
        "text": "escaleras: Em = 100 lx"
      }
    },
    {
      "id": "space-toilets",
      "selector": {
        "category": "OST_MEPSpaces",
        "name_matches": "(?i)ba[ñn]o|sanitario|vestier|vestidor|ducha|toilet|restroom"
      },
      "assertion": {
        "measure": "space_illuminance_lx",
        "operator": "gte",
        "value": 200
      },
      "severity": "advisory",
      "source": {
        "norm": "RETILAP 2024 (Resolucion 40150 de 2024), Libro 3",
        "numeral": "Tabla 3.2.2.6 a, ref. 2.4",
        "text": "banos, vestieres, duchas: Em = 200 lx"
      }
    },
    {
      "id": "space-kitchens",
      "selector": {
        "category": "OST_MEPSpaces",
        "name_matches": "(?i)cocina|kitchen"
      },
      "assertion": {
        "measure": "space_illuminance_lx",
        "operator": "gte",
        "value": 500
      },
      "severity": "advisory",
      "source": {
        "norm": "RETILAP 2024 (Resolucion 40150 de 2024), Libro 3",
        "numeral": "Tabla 3.2.2.6 a, ref. 29.2",
        "text": "cocinas (restaurantes y hoteles): Em = 500 lx"
      }
    },
    {
      "id": "space-storage",
      "selector": {
        "category": "OST_MEPSpaces",
        "name_matches": "(?i)bodega|dep[oó]sito|almac[eé]n|storage"
      },
      "assertion": {
        "measure": "space_illuminance_lx",
        "operator": "gte",
        "value": 200
