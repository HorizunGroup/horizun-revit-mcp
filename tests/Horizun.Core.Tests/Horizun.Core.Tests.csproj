<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Horizun Core tests — original Horizun code.

    Unit tests for the Revit-FREE honesty arithmetic in Reconcile.cs. That file
    carries no `using Autodesk.*`, so it is compiled straight INTO this project
    (a <Compile Include=".."> link) rather than by referencing Horizun.Revit —
    which pins RevitAPI and targets net8-windows and would drag Revit in.

    Plain net8.0: no Revit, no Windows desktop, runs anywhere `dotnet test` runs.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Revit-free sources under test, linked (not project-referenced) so
         nothing on the Revit runtime is pulled in. RequestGate is here for the
         same reason Reconcile is: it decides which caller gets which result, and
         that decision must be provable without a Revit in the room. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\Reconcile.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\RequestGate.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\CommandResult.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\LinkStatusTally.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\DocumentIdentity.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\WorksetConfigurationEvidence.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\ScriptOutput.cs" />
    <!-- The classification of a script's own success claim. The one rule it enforces -
         a "verified" claim without evidence is downgraded, never believed - is pure
         arithmetic over a JToken, so it is proved here, without a Revit. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ScriptEvidence.cs" />
    <!-- The machine-readable permission to fall back to Python, and the exception that
         carries a capability gap through the catch that flattens everything else to a
         string. Both Revit-free, and the invariant worth proving here is the one whose
         violation is expensive: allowed=true never travels with write_started=true. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\FallbackSignal.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\UnsupportedCapability.cs" />
    <!-- The one place the batch rule lives. It was four copies, and the mixed-batch
         defect shipped in all four; this is the piece whose behaviour is proved
         exhaustively so the commands only have to call it. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\FallbackDecision.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanFailure.cs" />
    <!-- What a command actually DID to the model, and the book a plan keeps while it
         runs. ExecutePlanCommand cannot be constructed without a Revit, so until these
         were split out every case that matters here was unreachable by any test: a
         child answering success over a rollback, a partial write followed by a DELETE,
         a failure in the middle of a graph that already wrote. The Revit stays in the
         command; the decision is proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ApplicationOutcome.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanLedger.cs" />
    <!-- And how a command's OWN counters become that declaration. Both rules here
         are ones review caught being got wrong: a TransactionStatus thrown away and
         replaced with a literal, and one `failed` array fed from three places whose
         total was then added to the request. Neither state can be asked of a live
         Revit - a Commit that returns Pending, a batch with one refused Set and one
         failed read-back - so both are pinned here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\WriteTally.cs" />
    <!-- Every property a request named, re-read from the committed model and
         compared one by one. The rule worth proving is what the old boolean could
         not say: an empty checklist is not a pass, and a property that could not be
         read is not agreement. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PostconditionCheck.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Transport\PipeEnvelope.cs" />
    <!-- Comment/string masking for the typed-overlap advisory. A live run advised a
         script whose only mention of the API was in a comment. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PythonSourceMask.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\Measurement.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\ClashLedger.cs" />
    <!-- The materialised plan: what a dry run RESOLVED, so an apply can tell that the
         model moved underneath it. Pure arithmetic over strings - the facts need Revit,
         the fingerprint does not - which is why the cases that matter (a collector
         re-ordering, a colleague editing the value this run was about to write) are
         provable here and not against a model somebody has to build first. -->
    <!-- Retention and redaction for the operation ledger. It DELETES somebody's audit
         trail, so every rule is proved here - including the two that must not happen: a
         malformed setting read as permission to delete, and a size cap dropping the
         newest receipt instead of the oldest. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ReceiptRetention.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\DurableStoreRetention.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\ResolvedPlan.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\RequirementSet.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\ReceiptLedger.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\Confirmation.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\GeometrySignature.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\LineReader.cs" />
    <!-- The async work queue and the job record it writes into. Neither touches
         Revit - the queue is a Queue<T> behind a lock, the record is a JSONL file -
         and the at-most-once guarantee they carry is the whole reason run_async is
         safe to point at a mutation. Both shipped with no test at all. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\AsyncQueue.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\Job.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\AsyncResultPayload.cs" />
    <!-- Job.cs reports a record it could not write through Log, and the admission rule
         both async entry points share is decided in AsyncJobAdmission. Both are
         Revit-free; the commands that call them are not, which is exactly why the rule
         was extracted to where it can be proved. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\Log.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\AsyncJobAdmission.cs" />
    <!-- The single data root both halves resolve. Job.cs asks it where to write, and
         the property under test is that the SERVER and REVIT reach the same folder
         even when their %LOCALAPPDATA% differ - which is provable here and nowhere
         else, because it needs two environments and no Revit. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\HorizunPaths.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\Settings.cs" />
    <!-- The other half of at-most-once. AsyncQueue guarantees a QUEUED entry runs
         once; this decides whether a request that arrived twice becomes one queue
         entry or two. Neither touches Revit, and the property is only worth having
         if both hold. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\Idempotency.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\DurableCommandIdempotency.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanReferences.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\JsonObjectKey.cs" />
    <!-- What happens to queued work when Revit will not take it. Denied cannot be
         produced on demand - it needs a Revit that is shutting down - so this path
         was reasoned and compiled and never exercised. Behind IWorkRaiser all three
         answers are ordinary test cases. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\AsyncLifecycle.cs" />
    <!-- The shared contract. It carries no Revit either, and ScriptOutput now takes its
         size limits from it rather than inventing a second copy of the same number. -->
    <Compile Include="..\..\src\Horizun.Contracts\Contract.cs" />
    <!-- Whether a model may be opened. The FACTS need Revit (a file header, a running
         host) and are gathered in OpenGuard.cs; the RULES are arithmetic over four
         strings and four booleans, and they lived in two large command files in two
         versions that had quietly diverged. Split out so the whole table is here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\OpenDecision.cs" />
    <!-- How on_open_dialog parses (5.22). The enum and the parse rule are Revit-free;
         the watcher that acts on the answer needs a Revit and is not here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\OpenDialogPolicy.cs" />
    <!-- Which files horizun_file_info reads (5.20). The directory listing is IO and
         injected; the refusal, the union, the dedup and the cap are proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\FileInfoPaths.cs" />
    <!-- And what the first eight bytes of an unreadable one MEAN (5.26). The read is
         IO; the rule is bytes in, sentence out - including the two it must refuse to
         say: a ZIP is not a Revit file, and an unknown signature is not anything. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\FileSignature.cs" />
    <!-- How a .py file's BYTES become the source that runs (5.27). The measured
         failure was a decode ("byte 0x8f in position 2634"), so the refusal, the
         PEP-263 line and the BOM cases are proved here rather than in a Revit. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PythonSourceText.cs" />
    <!-- What Revit raised, shaped for a caller (5.25). Interference needs a Revit to
         CATCH; this decides what the answer looks like, and the property that matters
         - an unobserved run must not read like a quiet one - has no Revit in it. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\RaisedRecord.cs" />
    <!-- And whether closing one would throw work away. The tri-state is the point:
         a real Revit will not produce "IsModified could not be read" on demand, and
         that is the state the rule has to get right. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\CloseDecision.cs" />
    <!-- When a probed modal dialog may be DECLARED (5.19). The probe needs Win32;
         the declaration rule is arithmetic over strings, and the states that
         matter - a flapping title, a dialog replaced mid-count - are here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ModalSighting.cs" />
    <!-- Which discovery files are orphaned (5.24). The rule the add-in and the
         server share, so the states that matter - a legacy name that must never
         be touched, a recycled pid that must keep its file - are proved once. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\DiscoverySweep.cs" />
    <!-- And how a close reaches a document Revit will let it close (5.13). The
         states that matter - every other document detached, no other document at
         all - are exactly the ones a live Revit will not produce on demand. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ActivationChoice.cs" />
    <!-- How much of a model an answer is about. The READING needs Revit and lives in
         DocumentVisibility.cs; the arithmetic and every sentence it reports are here,
         including the state a real Revit will not produce on request - the workset
         collector throwing, which is reported as incomplete rather than fine. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\DocumentVisibilityCoverage.cs" />
    <!-- The save evidence family_apply stands on (5.12). The failure it fixes only
         shows while another handle holds the file with write access - which a test
         can do and a code review cannot. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\FileFacts.cs" />
    <!-- Whether a planned write would move the parameter (5.14). The before-read
         needs Revit; the tri-state comparison is JToken arithmetic, and the two
         ways a boolean would lie - unknown collapsing into "it matches", and a
         unit string judged before Revit parses it - are pinned here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\WouldChange.cs" />
    <!-- Who else is talking to this Revit (5.16). The pid comes from the pipe and
         needs Windows; the window arithmetic, the minus-one rule and the
         lower-bound warning for an unreadable pid are proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\ClientPresence.cs" />
    <!-- Uploaded to ACC, or still pending? (5.15). The IO is the command's; the
         decode, the pair extraction and the name matching are proved here against
         synthetic WAL bytes shaped like the real ones - escaped JSON, NULs
         interleaved - because that shape is what the field script parsed. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\AccUploadWal.cs" />
    <!-- Which references horizun_get_dimension_references may offer, in what order,
         and under which fingerprint. The Revit geometry read is the command's; the
         selector table, the ambiguity shaping, the deterministic ordering and the
         0.1 mm quantised fingerprint are pure arithmetic proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\DimensionReferenceRules.cs" />
    <!-- Which dimension edits are eligible for which dimensions, and what the final
         state may claim once the transaction status is known. Depends only on
         ApplicationOutcome and PlanFailure, both linked above. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\DimensionEditRules.cs" />
    <!-- What horizun_annotate may promise about a dimension before Revit is asked, and
         what the outcome may claim afterwards: the conditional requirement table, the
         override/EQ/lock eligibility rules, the reference fingerprint and the
         final-state matrix are pure and proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\DimensionPlanRules.cs" />
    <!-- What horizun_detail_2d may accept and promise before Revit is asked: canonical
         curve/loop/region signatures on the 0.1 mm grid with exact integer topology,
         loop validation (self-intersection, exterior/hole hierarchy) and the error
         codes the contract publishes - pure, and proved here. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\Detail2DRules.cs" />
    <!-- The planimetry surface, split so that everything except the Revit READ is
         provable here: the layout arithmetic (touching is not overlapping, an
         unreadable box is not an empty one), the facts the inventory fills in, the
         universal rules, and the requirement-set loader with every refusal it owes.
         PlanimetryInventory.cs is deliberately NOT linked - it is the one half that
         needs a Document. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryGeometry.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryFacts.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryRequirementSet.cs" />
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryRules.cs" />
    <!-- The rules of CORRECTING a planimetry finding: the closed operation catalog,
         the universal-rule remedy table, finding identity vs observed staleness, batch
         claim discipline, and the resolved/persistent/new reconciliation. Everything
         except the Revit write is provable here; FixPlanimetryCommand.cs is the one
         half that needs a Document. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryFixRules.cs" />
    <!-- Deterministic autonomous sheet packing: pure rectangle arithmetic, fixed
         obstacles, all-or-nothing capacity and stable ordering. The Revit command
         only measures/creates the placements this rule decides. -->
    <Compile Include="..\..\src\Horizun.Revit\Core\PlanimetryPackingRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ScriptOutput serializes with Newtonsoft (the same version the plugin uses, which
         Revit itself ships). Pinned deliberately: a mismatch here would test a different
         serializer than the one that runs. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
